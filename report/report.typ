// =============================================================================
//  Оформление
// =============================================================================

#set page(
  paper: "a4",
  margin: (top: 22mm, bottom: 22mm, left: 25mm, right: 20mm),
  numbering: "1",
  number-align: center,
)
#set text(font: "Literata Fix", lang: "ru", size: 10.5pt, hyphenate: true)
#set par(justify: true, leading: 0.62em, first-line-indent: 0pt, spacing: 0.75em)
#show math.equation: set text(font: "Literata Math")
#set math.equation(numbering: none)

// В Literata Math курсивная тета нарисована в варианте «ϑ»; берём прямое
// начертание «θ», совпадающее по цвету и ширине с прочими греческими буквами
// этой гарнитуры. В формулах писать th, а не theta.
#let th = math.upright(sym.theta)

#set heading(numbering: (..n) => "Б." + n.pos().map(str).join(".") + ".")
#show heading: it => block(above: 1.5em, below: 0.9em)[
  #set text(size: 11pt, weight: "bold")
  #counter(heading).display(it.numbering) #h(0.4em) #it.body
]

#let parno = counter("par")
#let subno = counter("sub")

#let sect(title) = {
  parno.update(0)
  heading(title)
}

#let mark(extra) = context {
  let s = counter(heading).get().at(0)
  let n = parno.get().at(0)
  let parts = ("Б.", str(s), ".", str(n), ".")
  if extra != none { parts += (str(extra), ".") }
  strong(parts.join(""))
}

#let p(body, tag: none) = {
  parno.step()
  subno.update(0)
  block(above: 0.75em, below: 0.75em, width: 100%)[#mark(none) #body#if tag != none [#metadata(none)#tag]]
}

#let pp(body, tag: none) = {
  subno.step()
  context {
    let k = subno.get().at(0)
    pad(left: 1.4em, block(above: 0.5em, below: 0.5em, width: 100%)[
      #mark(k) #body#if tag != none [#metadata(none)#tag]
    ])
  }
}

// Ссылка на пункт по метке: #rf(<tag>) печатает «Б.3.12.3».
#let rf(tag) = context {
  let loc = query(tag).first().location()
  let s = counter(heading).at(loc).at(0)
  let n = parno.at(loc).at(0)
  let k = subno.at(loc).at(0)
  let out = "Б." + str(s) + "." + str(n)
  if k > 0 { out += "." + str(k) }
  out
}

#let whr(body, lead: none) = {
  if lead != none { block(above: 0.55em, below: 0.35em, lead) }
  pad(left: 1.4em, block(above: 0.25em, below: 0.6em, body))
}

#let eq(body) = block(above: 0.7em, below: 0.7em, width: 100%, align(center, body))

// =============================================================================
//  Текст
// =============================================================================

#align(center)[
  #block(width: 85%)[
    #set text(size: 13pt, weight: "bold")
    Приложение Б. Правила формирования Рейтинг-листа \ (новая система)
  ]
]

#v(1.2em)

#sect[Общие положения]

#p[Рейтингом называется система числовых оценок силы команд и игроков спортивного «Что? Где? Когда?», формируемая по результатам турниров, включённых в Рейтинг, и публикуемая в виде Релизов.]

#p[Релизом Рейтинга называется список команд, отсортированный по убыванию значения рейтинга команды, составленный по состоянию на четверг соответствующей недели. Одновременно с Релизом публикуется список игроков, отсортированный по убыванию значения индивидуального рейтинга.]

#p[Идентификаторами команды и игрока называются их идентификаторы в базе данных рейтинга (`team_id` и `player_id` соответственно). Команда сохраняет идентификатор при любых изменениях состава.]

#p[В Рейтинг включаются турниры, отмеченные в базе данных как рейтинговые, с датой начала не ранее #k_start и ранее #k_to#[;] верхняя граница отсекает турниры объявленные, но не сыгранные. Марафоны, асинхронные турниры и турниры нераспознанного типа в Рейтинг не включаются.]

#p[Весом турнира $w_t$ называется множитель доказательности результата, определяемый форматом турнира:]
#whr[
  очный турнир (обычный или региональный)~– #k_w_in#[;] \
  строго синхронный турнир~– #k_w_ssync#[;] \
  синхронный турнир~– #k_w_sync.
]

#p[Зачётным называется результат команды, отмеченный в базе данных признаком `inRating`. Незачётный результат принадлежит сборной, не имеющей базового состава. Он не даёт команде ни обновления рейтинга, ни доказательности, ни права на включение в Релиз и не открывает состояния команды. При этом команда остаётся в поле соперников для всех прочих и входит в попарное сравнение (#rf(<pairwise>)) со своей прогнозной силой, а её игроки обновляются в вопросной модели обычным порядком.]

#p[Числом вопросов $n_q$ турнира называется наибольшая длина маски среди его результатов. Если маски отсутствуют, $n_q$ есть сумма чисел вопросов по турам; если отсутствуют и они, в расчётах раздела Б.3 принимается $n_q$~= #k_n_fallback.]

#p[События обрабатываются в порядке возрастания даты начала турнира, а при совпадении дат~– в порядке возрастания идентификатора турнира. Обработка производится однократно и в прямом хронологическом порядке; опубликованное значение рейтинга не пересматривается.]

#p[Рейтингуемыми величинами называются:]
#whr[
  сила команды, её неопределённость и волатильность~– для каждой команды; \
  сила игрока, её неопределённость и волатильность~– для каждого игрока.
]

#p[Рейтинг команды и рейтинг игрока изменяются только по результатам сыгранного рейтингового турнира. Бездействие увеличивает неопределённость оценки и не уменьшает её значения.]

#p[В Релиз включаются только те команды и игроки, которые сыграли хотя бы один рейтинговый турнир в течение #k_window дней, предшествующих дате Релиза. Для команды при этом учитываются только зачётные результаты. Невключение в Релиз не изменяет состояния команды или игрока.]

#sect[Индивидуальный рейтинг]

#p[Состоянием игрока $i$ называется совокупность величин: сила $th_i$, неопределённость $sigma_i^2$ и волатильность $v_i$.]

#p(tag: <qmodel>)[Вопросной моделью называется вероятностная модель взятия вопроса составом команды. Вопрос $q$ характеризуется трудностью $b_q$ и логарифмом различающей способности $ln a_q$. Вероятность взятия вопроса $q$ составом $L$ равна]
#eq[$ P_(L,q) = 1 - exp(-u_q), quad u_q = sum_(i in L) lambda_(i,q), quad lambda_(i,q) = exp(a_q (th_i - b_q)). $]
#whr(lead: [где:])[
  $lambda_(i,q)$~– интенсивность игрока $i$ на вопросе $q$; \
  $u_q$~– суммарная интенсивность состава на вопросе $q$; \
  $a_q$~– различающая способность вопроса $q$; \
  $b_q$~– трудность вопроса $q$; \
  $L$~– состав команды, сыгравшей турнир.
]
#p[Модель, описанная в #rf(<qmodel>), называется моделью «шумного ИЛИ»: вопрос считается взятым, если его взял хотя бы один игрок состава, а вклады игроков независимы.]

#p[Насыщением называется приведение величины $u_q$ к отрезку $[exp(-u_"max"), u_"max"]$ перед подстановкой в вероятность, где $u_"max"$~= #k_u_max. Без насыщения предельно уверенный прогноз против наблюдённого исхода делает логарифмический убыток бесконечным.]

#p[Априорными распределениями параметров вопроса называются $ln a_q ~ N(0, s_a^2)$ и $b_q ~ N(overline(b), s_b^2)$, где $s_a$~= #k_s_a, $overline(b)$~= #k_b_bar, $s_b$~= #k_s_b.]

#p[Логарифмическое правдоподобие турнира есть сумма логарифмов вероятностей по всем вопросам и всем командам турнира, взятая с весом $w_t$; априорные слагаемые весом не умножаются. При этом:]
#pp[вопросы, отмеченные в маске символом снятия или неизвестности, исключаются;]
#pp[результаты с отсутствующей маской в вопросной модели не участвуют.]

#p[Обновлением по итогам турнира называется последовательность трёх шагов.]
#pp[Настройка вопросов. При зафиксированных силах игроков для каждого вопроса $q$ независимо подбираются $(b_q, ln a_q)$ ньютоновскими итерациями с демпфированием и половинным шагом по штрафованному логарифмическому правдоподобию, не более #k_newton итераций. Значения отсекаются: $a_q in [#k_a_min, #k_a_max]$, $b_q in [#k_b_min, #k_b_max]$.]
#pp[Обновление игроков. При зафиксированных параметрах вопросов для каждого игрока $i$, сыгравшего турнир, вычисляются градиент $g_i$ и наблюдённая информация Фишера $I_i$ логарифмического правдоподобия турнира по $th_i$, после чего]
#eq[$ I_"eff" = w_t I_i d_"info", quad pi'_i = 1 \/ sigma_i^2 + max(I_"eff", I_"min"), quad Delta th_i = (w_t d_"info" g_i) / pi'_i, quad sigma_i^2 <- 1 \/ pi'_i. $]
#whr(lead: [где:])[
  $d_"info"$~– коэффициент дисконтирования информации, #k_info_scale#[;] \
  $I_"min"$~– нижняя граница информации, #k_info_floor#[;] \
  $sigma_i^2$~– неопределённость после приращения по #rf(<diffusion>), взятая до обновления.
]
#p[Приращение силы ограничивается по модулю величиной #k_theta_step.]
#pp[Стягивание к составу. После обновления каждый игрок состава притягивается к средней силе состава:]
#eq[$ th_i <- th_i + f dot (1/(|L|) sum_(j in L) th_j - th_i), quad f = #k_shrink. $]

#p[Коэффициент $d_"info"$ введён потому, что ответы одной команды не независимы при заданных силах игроков: один турнир несёт меньше сведений, чем утверждает кривизна правдоподобия. Значение $d_"info"$ определяется требованием честности публикуемой неопределённости (#rf(<honest>)).]

#p[Стягивание к составу введено потому, что правдоподобие «шумного ИЛИ» приписывает взятие тому, кто уже сильнее, и разводит партнёров, играющих одни и те же вопросы, на тысячи мест. Значение $f = 0$ отключает стягивание.]

#p(tag: <diffusion>)[Между турнирами неопределённость оценки игрока увеличивается на $v_i^2 Delta t$, где $Delta t$~– интервал в годах, а $v_i$~– волатильность игрока. Волатильность своя у каждого игрока и обновляется после каждого турнира, на котором $I_"eff" > I_"min"$, по стандартизованной неожиданности]
#eq[$ z_i = (g_i \/ I_i) / sqrt(sigma_i^2 + 1 \/ I_"eff"), quad ln v_i <- ln v_i + eta_v (ln v_* - ln v_i), $]
#whr(lead: [где:])[
  $sigma_i^2$~– неопределённость до обновления; \
  $eta_v$~– скорость обучения волатильности, #k_v_eta#[;] \
  $v_*$~= $v_"max"$~= #k_v_max, если $|z_i| > 1$, и $v_*$~= $v_"min"$~= #k_v_min иначе.
]
#p[Тем самым долгая и ровная история сводит неопределённость к нижней границе независимо от календаря, и только череда результатов, непохожих на прошлые, открывает её вновь. Волатильность нового игрока равна #k_tau_p.]

#p[Новичком называется игрок, не имеющий сыгранных рейтинговых турниров. Новичок входит в Рейтинг со значениями $th$~= #k_mu_new и $sigma$~= #k_sigma_new. Для каждого игрока хранятся число сыгранных рейтинговых турниров и дата последнего из них.]

#p[Параметры вопросов сыгранного турнира сохраняются для отчётности и в дальнейших обновлениях не используются: вопрос не задаётся повторно.]

#p[Калибровкой шкалы называется операция, выполняемая при формировании каждого Релиза. Пусть]
#eq[$ Delta = 1/(|E|) sum_(i in E) th_i, $]
#whr(lead: [где:])[
  $E$~– множество игроков, сыгравших не менее #k_n_est рейтинговых турниров за предшествующие #k_window дней; \
  $Delta$~– сдвиг шкалы данного Релиза.
]
#p[Величина $Delta$ вычитается из силы каждого игрока, из рейтинга каждой команды и из опорной силы каждой команды. Тем самым средняя сила состоявшихся игроков в каждом Релизе равна нулю, и инфляция шкалы невозможна по построению. Трудности вопросов поправке не подлежат, поскольку вопросы не задаются повторно.]

#p[Состояния игроков и команд хранятся до вычета сдвига, а накопленный сдвиг вычитается при чтении. Поэтому публикуемое изменение величины с предыдущего Релиза, в который она была включена, есть её собственное движение, свободное от калибровки шкалы.]

#p[Индивидуальный рейтинг является прямой оценкой вопросной модели. Он публикуется вместе со своей неопределённостью; никаких правил перехода между разрядами, порогов и ограничений на изменение к нему не применяется.]

#p(tag: <reserved>)[Зарезервировано. Правилами предусмотрены два расширения вопросной модели, реализованные и испытанные, но отключённые в настоящей редакции; ни одно из них не понизило кросс-проверочный логарифмический убыток испытания #rf(<t_ll>). Первое~– свободное число шагов: вопрос наделяется параметром $m_q$, вероятность взятия принимает вид $P_(L,q)^(m_q)$, что штрафует составы с резко неравной силой игроков относительно ровных составов; среднее настроенное значение $m_q$ составило #k_m_mean, выигрыш достигался только внутри выборки. Второе~– сродство с редакторами: игрок наделяется вектором $u_i$, редактор~– вектором $v_e$, и сила игрока на турнире увеличивается на среднее скалярное произведение $u_i dot v_e$ по редакторам турнира; выученные величины не превысили #k_aff_mag по шкале силы, так как информация Фишера для $u_i$ меньше информации для $th_i$ и одного прямого прохода для её выделения недостаточно. Оба расширения сохранены в реализации за своими переключателями и зарезервированы для будущей редакции настоящих Правил.]

#sect[Рейтинг команды]

#p[Составной оценкой $s_r (L)$ состава $L$ называется величина]
#eq[$ s_r (L) = ln sum_(i in L) exp(th_i) + delta_0, quad "Var"(s_r (L)) = sum_(i in L) p_i^2 sigma_i^2 + sigma_"mod"^2, quad p_i = exp(th_i) / (sum_(j in L) exp(th_j)). $]
#whr(lead: [где:])[
  $s_r (L)$~– сила состава $L$, выраженная на шкале силы игрока; \
  $p_i$~– доля игрока $i$ в суммарной интенсивности состава; \
  $delta_0$~– поправка составной оценки, #k_roster_bias#[;] \
  $sigma_"mod"$~– остаточное среднеквадратичное отклонение силы команды вокруг составной оценки, #k_sigma_model.
]
#p[Поправка $delta_0$ есть среднее отклонение реализованной силы команды от непоправленной суммы сил её игроков. Она отрицательна: настоящие команды играют слабее оценки по независимым игрокам. Величины $delta_0$ и $sigma_"mod"$ определяются вне публикуемого контура (#rf(<offline>)).]

#p[Поправка $delta_0$ входит в составную оценку при заведении новой команды, при построении прогноза и в канал запаса (#rf(<apply>)). Опорная сила команды накапливает непоправленную оценку, поэтому смещение состава есть разность однородных величин и от поправки не зависит.]

#p[Состоянием команды $T$ называется совокупность величин:]
#whr[
  $mu_T$~– рейтинг команды; \
  $sigma_T^2$~– неопределённость рейтинга команды; \
  $v_T$~– волатильность команды; \
  $e_(T,i)$~– доказательность игрока $i$ в команде $T$, взвешенное число зачётных турниров, сыгранных им за эту команду; \
  $k_(T,i)$~– счётчик пропусков: число зачётных турниров команды подряд, пропущенных игроком $i$; \
  $E_T = sum_i e_(T,i)$~– полная доказательность команды; \
  $overline(s)_T$~– опорная сила команды, взвешенное по доказательности среднее непоправленных составных оценок тех составов, которыми заработан рейтинг $mu_T$; \
  дата последнего зачётного турнира команды и доля доказательности, утраченная на предыдущем турнире.
]

#p[Новой называется команда с $E_T = 0$. Новая команда входит в Рейтинг со значениями $mu_T = s_r (L)$, $sigma_T^2 = "Var"(s_r (L)) + sigma_"new"^2$, $overline(s)_T = s_r (L) - delta_0$ и $v_T$~= #k_tau_t, где $sigma_"new"$~= #k_sigma_new_team, а $L$~– её состав на первом турнире. Незачётный результат состояния команды не открывает.]

#p[Полем турнира называется совокупность его зачётных команд, имеющих непустой состав либо ранее открытое состояние; команда, не имеющая ни того, ни другого, пропускается. Величины #rf(<continuity>)–#rf(<pairwise>) читают состояния игроков в том виде, в каком они были до турнира, и вычисляются для всего поля прежде, чем записано хотя бы одно новое состояние.]

#p(tag: <continuity>)[Преемственностью $c$ называется доля доказательности команды, представленная сегодняшним составом:]
#eq[$ c = (sum_(i in L) e_(T,i)) / E_T. $]
#p[Для новой команды $c = 1$. Состав с $c = 0$ (идентификатор команды, использованный людьми, не имеющими к ней отношения) получает прогноз, но не порождает обновления рейтинга.]

#p[Смещением состава $delta_L$ называется величина $delta_L = (s_r (L) - delta_0) - overline(s)_T$~– насколько сегодняшний состав сильнее или слабее тех составов, которыми заработан рейтинг.]

#p[Ожидаемой силой команды на турнире называется величина $x_T = mu_T + delta_L$. Рейтинг команды оценивается относительно её собственного опорного состава: приглашённые игроки повышают ожидание, отсутствующие~– понижают.]

#p(tag: <pairwise>)[Попарным сравнением называется следующая процедура. Для каждой пары команд $A$ и $B$ поля]
#eq[$ P_(A B) = 1 / (1 + exp(-(x_A - x_B) \/ beta_t)), quad beta_t = beta sqrt(n_0 \/ n_q), $]
#eq[$ m_(A B) = min(1 + abs(z_A - z_B) \/ kappa, m_"max"), quad S_A = sum_(B != A) (y_(A B) - P_(A B)) m_(A B), quad I_A = sum_(B != A) P_(A B) (1 - P_(A B)) m_(A B). $]
#whr(lead: [где:])[
  $P_(A B)$~– вероятность того, что команда $A$ окажется выше команды $B$; \
  $y_(A B)$~– исход пары: 1, если $A$ заняла место выше $B$, и 0, если ниже; \
  $z_A$~– число правильных ответов команды $A$; \
  $m_(A B)$~– множитель разрыва, $kappa$~= #k_kappa, $m_"max"$~= #k_m_max#[;] \
  $n_q$~– число вопросов турнира, $n_0$~= #k_n_ref#[;] \
  $beta$~– наклон шкалы силы по попарным исходам на турнире из $n_0$ вопросов, #k_beta#[;] \
  $S_A$~– накопленное отклонение результата от ожидания; \
  $I_A$~– накопленная информация.
]
#p[Пара команд, разделивших место, в обеих суммах пропускается: такая пара ничего не сообщает о том, которая из двух команд сильнее, и равносильна $y = P$ при нулевой информации. Команда, входящая в попарное сравнение по незачётному результату, участвует в нём со своей прогнозной силой вместо $x_T$.]

#p[Команда с отсутствующей маской участвует в попарном сравнении по числу правильных ответов; если неизвестно и оно, для соответствующих пар $m_(A B) = 1$.]

#p[Поскольку для каждой пары, в которой команда $A$ оказалась выше, выполняется $y_(A B) - P_(A B) >= 0$, для команды, занявшей первое место, $S_A >= 0$. Тем самым такая команда ни при каких обстоятельствах не теряет рейтинговых очков~– как при единоличном первом месте, так и при делённом; разрыв в счёте влияет только на величину изменения, но не на его знак.]

#p[Нормировкой попарных сравнений называется умножение $S_A$ и $I_A$ на множитель $n_"eff" \/ (N - 1)$, где $N$~– число команд поля, $n_"eff" = min(N - 1, nu)$, $nu$~= #k_nu. Нормировка учитывает, что пары не являются независимыми наблюдениями.]

#p[Реализованной силой $s^*$ команды называется сила, при которой один игрок такой силы взял бы в точности столько вопросов данного пакета, сколько взяла команда. Она находится делением отрезка пополам по настроенным параметрам вопросов и не определена при отсутствующей маске.]

#p(tag: <apply>)[Обновление рейтинга команды производится по двум каналам точности, из которых среднее двигает только первый:]
#eq[$ pi_"pair" = (w_t c I_A) / beta_t^2, quad pi_"marg" = (w_t c) / sigma_"mod"^2, quad pi'_T = 1 \/ sigma_T^2 + pi_"pair" + pi_"marg", $]
#eq[$ mu_T <- mu_T + (w_t c S_A) / (beta_t pi'_T), quad sigma_T^2 <- max(1 \/ pi'_T, sigma_min^2). $]
#whr(lead: [где:])[
  $pi_"pair"$~– канал размещения, по попарному сравнению; \
  $pi_"marg"$~– канал запаса, равный нулю, если $s^*$ не определена; \
  $sigma_min$~= #k_sigma_floor~– нижняя граница неопределённости команды.
]
#p[Нижняя граница не даёт точности сложившейся команды расти без предела: канал запаса добавляет точность, не двигая среднего, и без границы команда с многолетней историей после года слабых результатов сдвигалась бы на единицы очков.]
#p[Счёт говорит, насколько сильна была команда, но не говорит, кого она обыграла, поэтому канал запаса уточняет оценку, не смещая её, и гарантия #rf(<winner>) остаётся точной. Без этого канала команда, выигрывающая почти все пары, имеет $P (1 - P) approx 0$, набирает сведения на порядок медленнее обычной и не покидает списка предварительных оценок.]

#p[Для калибровки неопределённости (#rf(<honest>)) сохраняется стандартизованный остаток того же наблюдения:]
#eq[$ z_T = (s^* - x_T) / sqrt(sigma_T^2 + sigma_"mod"^2), $]
#whr[
  где $sigma_T^2$~– неопределённость до обновления.
]

#p[Учётом составов называются следующие действия, производимые после обновления:]
#pp[для каждого игрока $i$ сыгравшего состава: $e_(T,i) <- min(e_(T,i) + w_t, e_"cap")$ и $k_(T,i) <- 0$, где $e_"cap"$~= #k_e_cap#[;]]
#pp[для каждого не сыгравшего игрока: $k_(T,i) <- k_(T,i) + 1$;]
#pp(tag: <departure>)[доказательность игрока, у которого $k_(T,i) >= K$, где $K$~= #k_miss, умножается на $rho$~= #k_rho и входит в утраченную долю $ell = sum e_(T,i) (1 - rho) \/ E_T$, вычисленную по значениям до уменьшения и ограниченную сверху величиной #k_ell_max#[;] неопределённость рейтинга увеличивается: $sigma_T^2 <- sigma_T^2 \/ (1 - ell)^gamma$, где $gamma$~= #k_gamma#[;]]
#pp[неопределённость ограничивается сверху величиной $"Var"(s_r (L)) + sigma_"new"^2$: после полной смены состава команда знает о себе не больше, чем новая команда того же состава;]
#pp[опорная сила $overline(s)_T$ пересчитывается как взвешенное среднее прежнего значения с весом $E_T$ до обновления и непоправленной оценки сегодняшнего состава с весом $w_t |L|$;]
#pp[волатильность команды обновляется по стандартизованной новизне попарного сравнения]
#eq[$ z_"pair" = (S_A beta_t \/ I_A) / sqrt(sigma_T^2 + 1 \/ pi_"pair"), quad ln v_T <- ln v_T + eta_v (ln v_* - ln v_T), $]
#whr[
  где $sigma_T^2$~– неопределённость до обновления, а $v_*$ определяется как в #rf(<diffusion>).
]

#p(tag: <winner>)[Правило #rf(<departure>) называется правилом ухода игроков. Условие на счётчик пропусков отделяет уход от ротации состава: без него команда, выставляющая девять игроков по очереди, считалась бы теряющей игрока каждую неделю. Правило не имеет порогов по величине, выпукло по утраченной доле доказательности и затрагивает только неопределённость: сам рейтинг ушедшими игроками не изменяется, но последующие результаты изменяют его быстро.]

#p[Между турнирами неопределённость рейтинга команды увеличивается на $v_T^2 Delta t$, где $Delta t$~– интервал в годах. Значение $mu_T$ при этом не изменяется.]

#p[Изменение состава команды само по себе не изменяет рейтинг ни одной команды. Пришедшие игроки остаются гостями, пока не заработают доказательность; их приход изменяет ожидаемую силу и прогноз, но не $mu_T$.]

#p[Дата последнего зачётного турнира команды продвигается только по зачётному результату.]

#sect[Прогноз]

#p[Прогнозом называется отдельный от рейтинга объект: оценка силы, с которой команда выступит на данном турнире данным составом. Прогноз не участвует в обновлении рейтинга и не влияет на него.]

#p[Прогнозной силой $f_T$ называется взвешенное по точности среднее ожидаемой силы команды и составной оценки её состава:]
#eq[$ f_T = (x_T \/ sigma_T^2 + s_r (L) \/ "Var"(s_r (L))) / (1 \/ sigma_T^2 + 1 \/ "Var"(s_r (L))). $]
#p[После значительной смены состава величина $sigma_T^2$ велика, и прогнозная сила близка к составной оценке; рейтинг команды при этом не изменяется.]

#p[Прогнозным местом команды называется её место в упорядочении команд поля по убыванию прогнозной силы; первое место соответствует наибольшей прогнозной силе.]

#p[Прогноз может учитывать состав, редакторов и формат турнира. Расширения, перечисленные в #rf(<reserved>), при их включении действуют в первую очередь на прогноз.]

#sect[Сложность турнира]

#p[Сложностью турнира $D_t$ называется величина, вычисляемая по настроенным параметрам его вопросов относительно неизменного эталонного состава из #k_ref_size одинаковых игроков силы $th^*$:]
#eq[$ p_q = (1 - exp(-6 exp(a_q (th^* - b_q))))^(m_q), quad D_t = 10 (1 - 1/(|Q|) sum_(q in Q) p_q), $]
#whr(lead: [где:])[
  $Q$~– множество вопросов турнира, взятых хотя бы одной командой; \
  $p_q$~– вероятность взятия вопроса $q$ эталонным составом; \
  $th^*$~– эталонная сила, #k_theta_ref.
]
#p[Сложность не определяется, если ни один вопрос турнира не был взят.]

#p[Эталонная сила $th^*$ есть сила сбалансированной команды мест #k_band, выраженная как #k_ref_size равных игроков. Она соответствует полосе, принятой за опорную в публикуемом показателе TrueDL, поэтому величина $D_t$ означает именно то, что этот показатель обещает: удесятерённую долю пакета, которую такая команда не возьмёт,~– но вычисляется по настроенным трудностям, а не по таблице отношений между полосами. Величина $th^*$ фиксируется при запуске и пересчёту не подлежит.]

#sect[Публикуемые величины]

#p(tag: <display>)[Публикуемым рейтингом называется аффинное отображение внутреннего значения:]
#eq[$ R_"team" = A_T + B_T mu_T, quad R_"player" = A_P + B_P th_i. $]
#whr(lead: [где:])[
  $A_T$~= #k_A_T, $B_T$~= #k_B_T~– постоянные командной шкалы; \
  $A_P$~= #k_A_P, $B_P$~= #k_B_P~– постоянные индивидуальной шкалы.
]

#p[Постоянные #rf(<display>) определены однократно из условия совпадения публикуемых значений на #{k_pos_hi}-м и #{k_pos_lo}-м местах со значениями старой системы для тех же мест: для команд~– #k_ref_t_50 и #k_ref_t_1000 в Релизе, ближайшем к #k_anchor_t, среди включённых в него команд с окончательной оценкой; для игроков~– #k_ref_p_50 и #k_ref_p_1000 в Релизе, ближайшем к #k_anchor_p. Верхняя часть таблицы располагается там, куда её помещает внутренняя шкала. После утверждения постоянные не пересматриваются.]

#p[Предварительной называется оценка, неопределённость которой превышает #k_prov_sigma по внутренней шкале. Предварительные оценки публикуются с соответствующей отметкой и в ранжированные таблицы не включаются.]

#p[Вместе с публикуемым рейтингом публикуются неопределённость оценки, число рейтинговых турниров за предшествующие #k_window дней, дата последнего из них и изменение рейтинга с предыдущего Релиза, в который величина была включена. Изменение свободно от калибровки шкалы и равно нулю при первом появлении и при неделе без игр.]

#p[По каждому турниру публикуются его сложность, а для каждой команды~– прогнозная сила, прогнозное и фактическое места, значения рейтинга и неопределённости до и после турнира, преемственность, смещение состава, составная оценка и признак зачётности результата.]

#sect[Проверка]

